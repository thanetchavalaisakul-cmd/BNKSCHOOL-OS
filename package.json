{
  "devDependencies": {
    "esbuild": "0.25.12"
  },
  "private": true,
  "scripts": {
    "build:app": "esbuild app.js --minify --charset=utf8 --format=esm --target=es2022 --outfile=app.min.js",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run build:app && node --check app.min.js && npm test"
  }
}
